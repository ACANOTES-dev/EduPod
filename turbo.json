{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "lint:ci": {},
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": [
        "tsconfig.tsbuildinfo",
        "dist/tsconfig.tsbuildinfo",
        "dist/tsconfig.build.tsbuildinfo",
        ".next/cache/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "CP_SAT_EARLY_STOP_GAP_THRESHOLD",
        "CP_SAT_EARLY_STOP_MIN_RUNTIME_SECONDS",
        "CP_SAT_EARLY_STOP_STAGNATION_SECONDS",
        "CP_SAT_NUM_SEARCH_WORKERS",
        "CP_SAT_REGRESSION",
        "CP_SAT_SIDECAR_CWD",
        "CP_SAT_SIDECAR_PORT",
        "CP_SAT_SIDECAR_UVICORN",
        "CP_SAT_WATCHDOG_SILENCE_SECONDS"
      ]
    },
    "test:changed": {
      "dependsOn": ["^build"],
      "env": [
        "CP_SAT_EARLY_STOP_GAP_THRESHOLD",
        "CP_SAT_EARLY_STOP_MIN_RUNTIME_SECONDS",
        "CP_SAT_EARLY_STOP_STAGNATION_SECONDS",
        "CP_SAT_NUM_SEARCH_WORKERS",
        "CP_SAT_REGRESSION",
        "CP_SAT_SIDECAR_CWD",
        "CP_SAT_SIDECAR_PORT",
        "CP_SAT_SIDECAR_UVICORN",
        "CP_SAT_WATCHDOG_SILENCE_SECONDS"
      ]
    }
  }
}
