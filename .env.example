# ============================================================
# School Operating System — Local Development Environment
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# ============================================================
# DATABASE (Phase 0)
# ============================================================
DATABASE_URL=postgresql://postgres:localpassword@localhost:6432/school_platform
DATABASE_MIGRATE_URL=postgresql://postgres:localpassword@localhost:5553/school_platform

# ============================================================
# REDIS (Phase 0)
# ============================================================
REDIS_URL=redis://localhost:5554

# ============================================================
# AUTH (Phase 1)
# ============================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-32>

# ============================================================
# SEARCH
# ============================================================
MEILISEARCH_URL=http://localhost:5555
MEILISEARCH_API_KEY=local-dev-master-key

# ============================================================
# ENCRYPTION
# Used for encrypting Stripe keys and staff bank details.
# ============================================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# ============================================================
# STRIPE — Test Mode (Phase 6)
# Each school enters their own keys in the admin UI.
# These are for YOUR development/testing only.
# ============================================================
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# COMMUNICATIONS — Resend (email) + Twilio (SMS, WhatsApp)
# ============================================================
# Per-tenant credentials only — there is no platform fallback.
# Configure via the school settings UI:
#   /<locale>/settings/communications/email
#   /<locale>/settings/communications/sms
#   /<locale>/settings/communications/whatsapp
#
# Webhook secrets are also per-tenant on each tenant_*_configs row;
# Impl 06 of the comms overhaul lands the per-tenant webhook
# verifier at /v1/webhooks/communications/{email,sms,whatsapp}/:tenantId.

# ============================================================
# AWS — Local Dev (Phase 6+ if using real S3/Secrets Manager)
# ============================================================
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=school-platform-dev

# ============================================================
# CLOUDFLARE (Production only — not needed locally)
# ============================================================
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ZONE_ID=...
# CLOUDFLARE_ACCOUNT_ID=...

# ============================================================
# MONITORING (Production only — optional for local dev)
# ============================================================
# SENTRY_DSN_BACKEND=https://...@sentry.io/...
# SENTRY_DSN_FRONTEND=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=...
# SENTRY_ORG=your-org
# SENTRY_PROJECT_BACKEND=school-api
# SENTRY_PROJECT_FRONTEND=school-web
# SENTRY_RELEASE=<git-sha-or-release-name>
# SENTRY_ENVIRONMENT=production
# DEPLOY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DEPLOY_TELEGRAM_BOT_TOKEN=123456:telegram-bot-token
# DEPLOY_TELEGRAM_CHAT_ID=123456789
# LOKI_PUSH_URL=https://<loki-host>/loki/api/v1/push
# LOKI_ENVIRONMENT=production
# LOKI_SERVICE_LABEL=api
# PGBOUNCER_ADMIN_URL=postgresql://postgres:...@127.0.0.1:6432/pgbouncer
# WORKER_HEALTH_URL=http://127.0.0.1:5556/health

# ============================================================
# APP
# ============================================================
NODE_ENV=development
APP_URL=http://localhost:5551
API_URL=http://localhost:5552
API_PORT=5552
PLATFORM_DOMAIN=localhost
MFA_ISSUER=SchoolOS
WORKER_PORT=5556
WORKER_SHUTDOWN_GRACE_MS=30000
# PM2 instance counts (default: 1, fork mode; >1 enables cluster mode)
# API_INSTANCES=1
# WEB_INSTANCES=1
SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_API_URL should be empty in production (client-side calls use relative paths via Next.js rewrites).
# Only set for local dev if not using the Next.js rewrite proxy.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SENTRY_DSN=

# ============================================================
# OBSERVABILITY (Impl 10 — Communications operational layer)
# ============================================================
# Shared-secret token allowing scrapers from non-loopback IPs to read
# /api/metrics. Loopback (127.0.0.1) is always allowed without a token.
# Generate with: `openssl rand -hex 32`
# METRICS_INTERNAL_TOKEN=

# ============================================================
# OFF-SITE BACKUP REPLICATION (Production / ops)
# ============================================================
# DATABASE_MIGRATE_URL=postgresql://...
# S3_ENDPOINT=https://<object-storage-endpoint>
# S3_REGION=eu-west-1
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_BUCKET_NAME=edupod-backups
# BACKUP_S3_PREFIX=postgresql/prod
